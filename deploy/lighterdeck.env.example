# Copy to /etc/lighterdeck/lighterdeck.env (owner root, group lighterdeck, mode 640) and fill in.
# Leave the three LIGHTER_* trading values empty to run read-only (charts + calendar).

LIGHTER_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=

# Long random string; the UI asks for it once and remembers it in the browser.
DASH_TOKEN=

# Optional hard caps on every opening order, manual or automatic. Leave empty for no cap.
MAX_NOTIONAL_USD=
MAX_ORDERS_PER_DAY=
# Worst-price margin for stop orders, in %.
MAX_SLIPPAGE_PCT=0.5

# Public read-only site: 1 = no API key, no orders, welcome bar and residence check.
PUBLIC_MODE=
# Link for "open a Lighter account"; empty uses the project's referral link.
REFERRAL_URL=

HOST=127.0.0.1
PORT=8200
